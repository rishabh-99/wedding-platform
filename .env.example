# ─────────────────────────────────────────────────────────────────────────────
# Wedding platform — environment configuration
#
# DEVELOPMENT needs NO .env file: `docker compose up` uses safe local defaults
# (Postgres in Docker, local-disk media, log-only email).
#
# PRODUCTION: copy to .env on the server and fill in every value marked REQUIRED.
#   cp .env.example .env && nano .env
# Never commit .env. Nothing in here is ever sent to browsers.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ────────────────────────────────────────────────────────────────────
# REQUIRED: your domain, without https:// (used by nginx and Let's Encrypt)
DOMAIN=wedding.example.com
# REQUIRED: public URL of the site (used for calendar links, OG tags, CORS)
PUBLIC_URL=https://wedding.example.com
# Email for Let's Encrypt expiry notices
LETSENCRYPT_EMAIL=you@example.com
# Also request a certificate for www.<domain> (requires a www DNS record)
INCLUDE_WWW=true
# Extra allowed CORS origins (comma-separated). Defaults to PUBLIC_URL.
CORS_ORIGINS=

# ── Database ────────────────────────────────────────────────────────────────
# Containerised Postgres (docker-compose.prod.yml `db` service):
POSTGRES_USER=wedding
# REQUIRED: long random password, e.g. `openssl rand -base64 32 | tr -d '/+='`
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=wedding
# REQUIRED: must match the values above (or point at Amazon RDS instead)
DATABASE_URL=postgresql://wedding:change-me-to-a-long-random-password@db:5432/wedding?schema=public

# ── Security ────────────────────────────────────────────────────────────────
# REQUIRED: 64+ random characters, e.g. `openssl rand -hex 48`
JWT_SECRET=
# Admin session length
SESSION_TTL_HOURS=12
# Cookies are Secure (HTTPS-only) automatically in production
# COOKIE_SECURE=true

# First admin account — created by the seed on an EMPTY database only.
# REQUIRED in production: the default development password is refused.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ON_EMPTY=true

# ── Media storage ───────────────────────────────────────────────────────────
# local = Docker volume on the instance; s3 = Amazon S3 (recommended for production)
STORAGE_DRIVER=s3
S3_BUCKET=my-wedding-media-bucket
S3_REGION=ap-south-1
# Optional key prefix inside the bucket (e.g. "prod/")
S3_PREFIX=
# Presigned URL lifetime for guests' browsers (seconds)
S3_PRESIGN_TTL_SECONDS=21600
# Optional: serve media through CloudFront instead of presigned URLs
# S3_PUBLIC_BASE_URL=https://dxxxxxxxx.cloudfront.net
# Optional: S3-compatible endpoints (MinIO, R2…)
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
#
# AWS credentials: prefer an EC2 instance role (no keys on disk). Only if you cannot:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Email (RSVP notifications to the hosts) ─────────────────────────────────
# log = write emails to the app log; smtp = send via SMTP (e.g. Amazon SES SMTP)
EMAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM=Wedding <no-reply@wedding.example.com>
ADMIN_NOTIFY_EMAIL=

# ── Backups (docker/backup.sh from cron) ────────────────────────────────────
# Optional: copy nightly dumps to S3 (needs the AWS CLI on the host)
BACKUP_S3_URI=
BACKUP_KEEP_DAYS=30

# ── Misc ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
